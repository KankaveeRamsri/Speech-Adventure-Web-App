# Speech Adventure — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored (.env* pattern in .gitignore).
# This file (.env.example) is safe to commit — it contains ONLY placeholders.
#
# How to get Supabase values:
#   1. Create a project at https://app.supabase.com
#   2. Go to Project Settings → API
#   3. Copy "Project URL" → NEXT_PUBLIC_SUPABASE_URL
#   4. Copy "anon public" key → NEXT_PUBLIC_SUPABASE_ANON_KEY
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage Provider ──────────────────────────────────────────────────────────
# Controls which repository backend the app uses.
# Allowed values: local | supabase | hybrid
# Default (when unset): local
#
# - "local"    → all data in browser localStorage (default, no Supabase needed)
# - "supabase" → all data in Supabase (requires URL + KEY + user auth session)
# - "hybrid"   → Supabase primary, localStorage fallback
#
# Keep "local" until Supabase credentials are real.
NEXT_PUBLIC_STORAGE_PROVIDER=local

# ── Feature Flags ──────────────────────────────────────────────────────────────
# Central feature configuration — see src/lib/config/featureFlags.ts.
# Each accepts "true" | "false"; any other value (including unset) falls back
# to the Phase 1 default shown below. Architecture and database schema for
# disabled features are preserved, not deleted — flip the value to re-enable.
#
# NEXT_PUBLIC_ENABLE_SCHOOL_ADMIN=false   # default: false — School Admin hidden from signup/nav/routes
# NEXT_PUBLIC_ENABLE_THERAPIST=false      # default: false — Therapist role not yet built
# NEXT_PUBLIC_ENABLE_TEACHER_V2=true      # default: true  — Teacher V2 foundation

# ── Supabase Project ──────────────────────────────────────────────────────────
# Required for Supabase Auth and cloud storage (any provider other than "local")
# Leave as placeholder to run in localStorage-only mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Speech Evaluation Provider ────────────────────────────────────────────────
# Controls which AI backend evaluates speech attempts.
# Allowed values: mock | openai
# Default (when unset): mock
#
# - "mock"   → deterministic fake scores, no API call, free (default)
# - "openai" → Whisper transcription + GPT scoring; requires OPENAI_API_KEY
#
# SERVER-SIDE ONLY — do NOT prefix with NEXT_PUBLIC_
SPEECH_EVALUATION_PROVIDER=mock

# ── Sample Audio Provider ─────────────────────────────────────────────────────
# Controls which backend generates sample audio for practice items.
# Allowed values: mock | openai
# Default (when unset): mock
#
# - "mock"   → browser speechSynthesis TTS (free, no API key needed)
# - "openai" → OpenAI TTS (better quality); requires OPENAI_API_KEY
#
# SERVER-SIDE ONLY — do NOT prefix with NEXT_PUBLIC_
SAMPLE_AUDIO_PROVIDER=mock

# ── OpenAI Credentials ────────────────────────────────────────────────────────
# Required only when SPEECH_EVALUATION_PROVIDER=openai or SAMPLE_AUDIO_PROVIDER=openai.
# SERVER-SIDE ONLY — never use NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=sk-your-openai-key-here

# ── OpenAI Model Overrides (optional) ────────────────────────────────────────
# These have safe defaults — only set to override.
# OPENAI_TTS_MODEL defaults to "tts-1" (faster/cheaper; use "tts-1-hd" for quality)
# OPENAI_TTS_VOICE defaults to "alloy" (neutral Thai-capable voice)
#OPENAI_TTS_MODEL=tts-1
#OPENAI_TTS_VOICE=alloy
